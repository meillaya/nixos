#!/usr/bin/env bash
# One-command NixOS install for a host declared in this flake.
#
# Run it as root on the target machine, inside a live Linux environment that has
# Nix. The flake's own installer ISO (`nix build .#iso.<host>`) is the supported
# environment: it carries a running sshd and can boot in RAM, so wiping the disk
# underneath it is safe. Any live Linux with Nix and sshd also works.
#
#   sudo nix run --extra-experimental-features 'nix-command flakes' \
#     github:meillaya/nixos#install -- --yes
#
# Stages:
#   1. copy this flake into a writable work tree (default /root/nixos-install),
#   2. probe the real hardware of this machine and write the reviewed
#      enrollment artifacts through the same pipeline the ISO oneshot uses,
#   3. commit the enrollment into the work tree and fold the freshly generated
#      host key into the operator sops store when it is available,
#   4. hand the build gate and the destructive nixos-anywhere install to
#      bin/host-install.sh --install-only, which re-checks --yes itself.
#
# Without --yes the run stops after the enrollment checkpoint: the hardware
# declaration is reviewed in the work tree before anything touches the disk.
set -euo pipefail

orig_args=("$@")

host=""
disk=""
workdir=""
save_dir=""
trust_file=""
reviewer="${USER:-install}"
target_host="127.0.0.1"
install_user=""
install_uid=""
install_gid=""
stage=""
assume_yes=false
dry_run=false
install_only=false
skip_fold=false
allow_mounted_root=false
rescue_identity=false

usage() {
  cat <<'EOF'
Usage: nix run .#install -- [options]

Installs NixOS on the machine running this command, using the flake's reviewed
hardware-enrollment pipeline. Requires root (sudo re-execs automatically) and a
live Linux environment with sshd (the flake's own ISO is recommended).

Options:
  --host NAME        flake host to install (default: auto-detected from DMI;
                     a ThinkPad P52 maps to antagony)
  --disk BASENAME    pin the target whole-device /dev/disk/by-id basename
                     (default: auto-discover the internal disk)
  --workdir DIR      writable work tree (default /root/nixos-install; reused
                     when it already holds a flake)
  --save DIR         also copy the enrollment artifacts (declaration, intake
                     document, host key) to DIR on persistent storage; the
                     artifacts are staged into the installed system regardless
  --trust FILE       operator trust fixture (default: generated from the
                     fleet record by scripts/hardware/gen_trust.py)
  --reviewer NAME    reviewer principal recorded in the intake document
  --target-host ADDR install address (only 127.0.0.1/localhost; this installer
                     cannot install a remote machine)
  --yes              confirm the destructive install (without it the run stops
                     after the enrollment checkpoint)
  --install-only     skip probe/enroll/fold; install the work tree as-is
  --skip-fold        keep the host key local instead of folding it into the
                     sops store
  --allow-mounted-root
                     proceed even when / is a disk filesystem; only safe when
                     the enrolled target disk is not the running root
  --rescue-identity  mount the live btrfs layout read-only and copy the held age
                     identity (~/.config/sops/age/keys.txt) into the stage; use
                     it when that identity is the only copy and the disk is
                     about to be wiped. Dies when the identity cannot be found.
  --dry-run          print the plan and execute nothing
  -h, --help         show this help
EOF
}

die() {
  printf 'install: %s\n' "$*" >&2
  exit 1
}

while (( $# > 0 )); do
  case "$1" in
    --host=*) host=${1#*=}; shift ;;
    --host)
      (( $# >= 2 )) || die "--host requires a value"
      host=$2
      shift 2
      ;;
    --disk=*) disk=${1#*=}; shift ;;
    --disk)
      (( $# >= 2 )) || die "--disk requires a value"
      disk=$2
      shift 2
      ;;
    --workdir=*) workdir=${1#*=}; shift ;;
    --workdir)
      (( $# >= 2 )) || die "--workdir requires a value"
      workdir=$2
      shift 2
      ;;
    --save=*) save_dir=${1#*=}; shift ;;
    --save)
      (( $# >= 2 )) || die "--save requires a value"
      save_dir=$2
      shift 2
      ;;
    --trust=*) trust_file=${1#*=}; shift ;;
    --trust)
      (( $# >= 2 )) || die "--trust requires a value"
      trust_file=$2
      shift 2
      ;;
    --reviewer=*) reviewer=${1#*=}; shift ;;
    --reviewer)
      (( $# >= 2 )) || die "--reviewer requires a value"
      reviewer=$2
      shift 2
      ;;
    --target-host=*) target_host=${1#*=}; shift ;;
    --target-host)
      (( $# >= 2 )) || die "--target-host requires a value"
      target_host=$2
      shift 2
      ;;
    --yes) assume_yes=true; shift ;;
    --install-only) install_only=true; shift ;;
    --skip-fold) skip_fold=true; shift ;;
    --allow-mounted-root) allow_mounted_root=true; shift ;;
    --rescue-identity) rescue_identity=true; shift ;;
    --dry-run) dry_run=true; shift ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
done

[[ "$(uname -s)" == "Linux" ]] || die "this installer targets Linux"
case "$target_host" in
  127.0.0.1|localhost|::1) ;;
  *) die "the one-command installer only installs the machine it runs on; use bin/host-install.sh for a remote target" ;;
esac
[[ "$reviewer" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "--reviewer must match [A-Za-z0-9._-]{1,64}"

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
flake_root=$(cd -- "${script_dir}/../.." && pwd -P)
[[ -f "$flake_root/flake.nix" ]] || die "cannot locate the flake root from ${BASH_SOURCE[0]}"

# Shared staging builder (wave 1): staging_init/staging_password mint the
# per-install password hash into a tmpfs stage that `nixos-anywhere
# --extra-files` copies into the target. The helper also reports the ownership
# target for the user-owned subtree, which the install phase forwards --chown.
# shellcheck source=../../bin/_install-staging.sh
# shellcheck disable=SC1091
source "$flake_root/bin/_install-staging.sh"

# Resolve the enrolled user identity for $host: the staged base record first
# (enroll has just written it), else the flake's machine authority (dry-run
# display). Failure leaves the identity unset so the plan shows the
# <user>/<uid>/<gid> placeholders instead of guessing.
resolve_identity() {
  local raw="" identity=""
  if [[ -f "${staging:-}/base.json" ]]; then
    raw=$(cat "$staging/base.json") || raw=""
  elif [[ -n "$host" ]]; then
    raw=$(timeout 900 nix eval --impure --json --expr \
      "(import ${flake_root}/modules/entities/_machine-authority/model.nix).getMachine \"${host}\"" 2>/dev/null) || raw=""
  fi
  [[ -n "$raw" ]] || return 0
  identity=$(printf '%s' "$raw" | python3 -c \
    'import json, sys
identity = json.load(sys.stdin)["identity"]
print(identity["name"], identity["uid"], identity["gid"])' 2>/dev/null) || identity=""
  [[ -n "$identity" ]] || return 0
  read -r install_user install_uid install_gid <<<"$identity"
}

# DMI product string of the running machine: the only hardware fact available
# before enrollment.
dmi_product() {
  local product
  product=$(cat /sys/devices/virtual/dmi/id/product_version 2>/dev/null || true)
  [[ -n "$product" ]] || product=$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || true)
  printf '%s\n' "$product"
}

# Map a DMI product string to a declared flake host. Empty output means "this
# product is not a declared host"; callers refuse rather than guess. Add the
# machine's product line here when declaring a host.
dmi_host_for_product() {
  case "$1" in
    "ThinkPad P52") printf 'antagony\n' ;;
    *) : ;;
  esac
}

if [[ -z "$host" ]]; then
  product=$(dmi_product)
  host=$(dmi_host_for_product "$product")
  if [[ -n "$host" ]]; then
    printf 'install: detected host %s from DMI product "%s"\n' "$host" "$product"
  fi
fi

if [[ "$dry_run" == true ]]; then
  resolve_identity
  ownership_plan="home/<user>/.config <uid>:<gid>"
  if [[ -n "$install_user" ]]; then
    ownership_plan="home/${install_user}/.config ${install_uid}:${install_gid}"
  fi
  rescue_plan=""
  if [[ "$rescue_identity" == true ]]; then
    rescue_plan=$'\n  5b. rescue     mount the live btrfs @home read-only, copy ~/.config/sops/age/keys.txt into the stage, unmount (--rescue-identity; dies if the identity is missing)'
  fi
  printf 'install plan (host: %s, target: root@%s)\n' "${host:-<host>}" "$target_host"
  cat <<EOF
  1. work tree   cp -a ${flake_root}/. -> ${workdir:-/root/nixos-install} (reused if it already holds a flake)
  2. enrollment  python3 -m scripts.hardware.auto_enroll --host ${host:-<host>} --base <machine record> --trust <generated> --out <workdir>/.install-staging
  3. commit      config/hosts/intake/${host:-<host>}.json + .intake.json
  4. host key    bin/nix-config-host-key-enroll <host-key> ${host:-<host>}   (optional: --skip-fold keeps it local)
  5. staging     tmpfs stage per run (removed on exit): var/lib/nixos-bootstrap/<user>-password.hash (0700 dir, 0600, yescrypt)
                 var/lib/nixos-enrollment/<candidate,intake,host-key> (0700 dir, 0600), copied into the installed system
                 home/<user>/.config/sops/age/keys.txt (0600) from \$SOPS_AGE_KEY_FILE else ~/.config/sops/age/keys.txt
                 transport: --extra-files <stage> --chown ${ownership_plan}
                 the plaintext password is printed once and never written to disk${rescue_plan}
  6. install     <workdir>/bin/host-install.sh --host ${host:-<host>} --target-host ${target_host} --install-only --yes --skip-verify --extra-files <stage> --chown ${ownership_plan}
                 (refused unless / is a live tmpfs/overlay root, or --allow-mounted-root)
EOF
  exit 0
fi

[[ -n "$host" ]] || die "cannot infer a flake host for this machine; pass --host <name>"
workdir=${workdir:-/root/nixos-install}
staging="$workdir/.install-staging"

if (( EUID != 0 )); then
  if command -v sudo >/dev/null 2>&1; then
    exec sudo --preserve-env=PATH -- "$0" "${orig_args[@]}"
  fi
  die "must run as root"
fi

declared_hosts=$(nix eval --impure --json --expr \
  "builtins.attrNames (builtins.getFlake \"path:${flake_root}\").nixosConfigurations" 2>/dev/null) \
  || die "cannot evaluate the flake at ${flake_root}"
case "$declared_hosts" in
  *"\"${host}\""*) ;;
  *) die "host '${host}' is not a nixosConfiguration of this flake" ;;
esac

prepare_worktree() {
  if [[ -f "$workdir/flake.nix" ]]; then
    printf 'install: reusing work tree %s\n' "$workdir"
  else
    mkdir -p "$workdir"
    cp -a "$flake_root/." "$workdir/"
    chmod -R u+w "$workdir"
  fi
  if [[ ! -d "$workdir/.git" ]]; then
    # A store copy may carry a .git file pointing at the original checkout;
    # never commit into that repository.
    rm -f "$workdir/.git"
    git -C "$workdir" init -q
  fi
  git -C "$workdir" config user.email "nixos-install@localhost"
  git -C "$workdir" config user.name "nixos install"
  if ! git -C "$workdir" rev-parse HEAD >/dev/null 2>&1; then
    git -C "$workdir" add -A
    git -C "$workdir" commit -q -m "install: work tree for ${host}"
  fi
}

setup_self_ssh() {
  mkdir -p /root/.ssh
  chmod 700 /root/.ssh
  if [[ ! -f /root/.ssh/id_ed25519 ]]; then
    ssh-keygen -q -t ed25519 -N '' -C nixos-install -f /root/.ssh/id_ed25519
  fi
  touch /root/.ssh/authorized_keys
  chmod 600 /root/.ssh/authorized_keys
  local pub
  pub=$(cat /root/.ssh/id_ed25519.pub)
  grep -qxF "$pub" /root/.ssh/authorized_keys || printf '%s\n' "$pub" >> /root/.ssh/authorized_keys
  systemctl start sshd >/dev/null 2>&1 || true
  if ! ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=10 "root@${target_host}" true >/dev/null 2>&1; then
    die "root@${target_host} is not reachable over SSH; nixos-anywhere needs a running sshd that accepts the root key (the flake's ISO provides one)"
  fi
}

enroll() {
  rm -rf "$staging"
  mkdir -p "$staging"

  # The base is the flake's current machine record: the inline pending
  # declaration until the first enrollment, the committed record afterwards.
  nix eval --impure --json --expr \
    "(import ${workdir}/modules/entities/_machine-authority/model.nix).getMachine \"${host}\"" \
    > "$staging/base.raw.json" || die "cannot read the machine record for ${host}"
  PYTHONPATH="$workdir" python3 - "$staging/base.raw.json" "$staging/base.json" <<'PY'
import json
import sys
from pathlib import Path
from scripts.support.canonical_json import encode

Path(sys.argv[2]).write_bytes(encode(json.loads(Path(sys.argv[1]).read_text())))
PY

  if [[ -n "$trust_file" ]]; then
    cp "$trust_file" "$staging/trust.json"
  else
    PYTHONPATH="$workdir" python3 "$workdir/scripts/hardware/gen_trust.py" \
      --host "$host" -o "$staging/trust.json" \
      || die "trust generation failed; pass --trust <file> or restore the operator secrets"
  fi

  local -a disk_args=()
  [[ -n "$disk" ]] && disk_args=(--disk "$disk")
  PYTHONPATH="$workdir" python3 -m scripts.hardware.auto_enroll \
    --host "$host" \
    --base "$staging/base.json" \
    --trust "$staging/trust.json" \
    --out "$staging" \
    --reviewer "$reviewer" \
    "${disk_args[@]}" \
    || die "hardware enrollment failed; nothing was installed"

  cp "$staging/${host}.json" "$workdir/config/hosts/intake/${host}.json"
  cp "$staging/${host}.intake.json" "$workdir/config/hosts/intake/${host}.intake.json"
  git -C "$workdir" add "config/hosts/intake/${host}.json" "config/hosts/intake/${host}.intake.json"
  if ! git -C "$workdir" diff --cached --quiet; then
    git -C "$workdir" commit -q -m "enroll: refresh ${host}"
  fi

  PYTHONPATH="$workdir" python3 - "$workdir/config/hosts/intake/${host}.json" <<'PY'
import json
import sys

machine = json.load(open(sys.argv[1]))
gpu = machine["devices"]["gpu"]
gpu_note = f"/{gpu['expectedDriver']}" if gpu else ""
print(f"install: enrollment for {machine['hostId']} ({machine['cpuVendor']})")
print(f"  gpu      {machine['gpu']} {gpu_note}")
print(f"  disk     /dev/disk/by-id/{machine['storage']['diskById']} ({machine['storage']['expected']['sizeBytes']} bytes)")
print(f"  network  {machine['network']} (wifi {machine['capabilities']['values']['network.wifi']['state']}, ethernet {machine['capabilities']['values']['network.ethernet']['state']})")
print(f"  power    {machine['capabilities']['values']['power']['state']} (suspend {machine['capabilities']['values']['suspend']['state']})")
PY
}

fold_host_key() {
  want_save=false
  if [[ "$skip_fold" == true ]]; then
    printf 'install: --skip-fold: host key kept at %s/%s.host-key\n' "$staging" "$host"
    want_save=true
    return 0
  fi
  local age_key="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
  if [[ -f "$workdir/secrets/remembrance-keys.yaml" && -f "$age_key" ]]; then
    ( cd "$workdir" && bin/nix-config-host-key-enroll "$staging/${host}.host-key" "$host" ) \
      || die "host-key fold failed; pass --skip-fold --save DIR to keep the enrollment local"
    # The sops store is gitignored by design; -f mirrors the operator flow when
    # the work tree has not force-added the store yet.
    git -C "$workdir" add secrets/remembrance-keys.yaml 2>/dev/null \
      || git -C "$workdir" add -f secrets/remembrance-keys.yaml
    if ! git -C "$workdir" diff --cached --quiet; then
      git -C "$workdir" commit -q -m "enroll: fold ${host} host key"
    fi
  else
    printf 'install: no sops store or age identity at %s; host key stays at %s/%s.host-key\n' \
      "$age_key" "$staging" "$host" >&2
    want_save=true
  fi
}

save_artifacts() {
  [[ -n "$save_dir" ]] || return 0
  mkdir -p "$save_dir"
  cp -a "$staging/${host}.json" "$save_dir/${host}.json"
  cp -a "$staging/${host}.intake.json" "$save_dir/${host}.intake.json"
  if [[ -f "$staging/${host}.host-key" ]]; then
    cp -a "$staging/${host}.host-key" "$save_dir/${host}.host-key"
    chmod 600 "$save_dir/${host}.host-key"
  fi
  printf 'install: enrollment artifacts saved to %s\n' "$save_dir"
}

# Stage the enrollment artifacts (candidate, intake document, host key) the
# enroll step just produced. A missing piece warns instead of aborting: the
# install stays valid, and a partial set only loses recoverability.
stage_enrollment_artifacts() {
  local stage="$1" src
  local -a artifacts=()
  for src in "${host}.json" "${host}.intake.json" "${host}.host-key"; do
    [[ -f "$staging/$src" ]] && artifacts+=("$staging/$src")
  done
  if (( ${#artifacts[@]} == 0 )); then
    printf 'install: warning: no enrollment artifacts under %s to stage\n' "$staging" >&2
    return 0
  fi
  staging_artifacts "$stage" "${artifacts[@]}" \
    || printf 'install: warning: could not stage every enrollment artifact; continuing\n' >&2
  return 0
}

# Stage the held age identity at home/<user>/.config/sops/age/keys.txt. The
# source order mirrors fold_host_key: $SOPS_AGE_KEY_FILE, else the default
# ~/.config/sops/age/keys.txt. An absent or unreadable source warns and
# continues; the identity is never fed into the sops fold.
stage_age_identity() {
  local stage="$1" keyfile
  if [[ "$rescue_identity" == true ]]; then
    rescue_age_identity "$stage"
    return $?
  fi
  keyfile="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
  if [[ ! -f "$keyfile" ]]; then
    printf 'install: warning: no age identity at %s; the installed system will need one before it can decrypt secrets\n' "$keyfile" >&2
    return 0
  fi
  staging_identity "$stage" "$install_user" "$install_uid" "$install_gid" "$keyfile" \
    || printf 'install: warning: could not stage the age identity from %s; continuing\n' "$keyfile" >&2
  return 0
}

# Mint the per-install password into a fresh tmpfs stage and copy in the
# enrollment artifacts and the age identity. staging_init installs the EXIT
# trap that removes the stage; staging_password prints the plaintext exactly
# once and never writes it to disk. Called only on the full install path, so
# --install-only never stages a second time.
stage_install_payload() {
  staging_init || return 1
  stage=$STAGING_DIR
  staging_password "$stage" "$install_user" || return 1
  stage_enrollment_artifacts "$stage"
  stage_age_identity "$stage"
}

# Compare the freshly probed candidate against the record baked into the work
# tree, and refuse to install a declaration onto hardware it does not describe.
# A pending record carries no hardware to compare, so its DMI product must map
# to --host instead; there is no override.
verify_host_match() {
  local baked="$staging/base.json" candidate="$staging/${host}.json"
  [[ -f "$baked" ]] || die "verify_host_match: no machine record at ${baked}"
  [[ -f "$candidate" ]] || die "verify_host_match: no candidate record at ${candidate}"

  local pending
  pending=$(python3 -c 'import json, sys
record = json.load(open(sys.argv[1]))
storage = record.get("storage") or {}
print("true" if record.get("cpuVendor") == "pending" and storage.get("profile") == "none" else "false")' \
    "$baked" 2>/dev/null) || die "verify_host_match: cannot read ${baked}"

  if [[ "$pending" == true ]]; then
    local product mapped
    product=$(dmi_product)
    mapped=$(dmi_host_for_product "$product")
    [[ -n "$mapped" ]] \
      || die "DMI product '${product}' does not map to a declared host; add its mapping before installing (no override)"
    [[ "$mapped" == "$host" ]] \
      || die "DMI product '${product}' maps to '${mapped}', not '--host ${host}'; refusing to install the wrong declaration"
    printf 'install: host match OK (pending record): DMI "%s" -> %s\n' "$product" "$host"
    return 0
  fi

  if ! python3 - "$baked" "$candidate" "$host" <<'PY'
# verify-host-match: the candidate hardware must equal the baked record on the
# storage bindings and the CPU vendor; any difference aborts before the wipe.
import json
import sys

baked = json.load(open(sys.argv[1]))
candidate = json.load(open(sys.argv[2]))
host = sys.argv[3]


def storage(record):
    return record.get("storage") or {}


def expected(record):
    return storage(record).get("expected") or {}


checks = [
    ("storage.diskById", storage(baked).get("diskById"), storage(candidate).get("diskById")),
    ("storage.expected.sizeBytes", expected(baked).get("sizeBytes"), expected(candidate).get("sizeBytes")),
    ("storage.expected.logicalSectorBytes", expected(baked).get("logicalSectorBytes"), expected(candidate).get("logicalSectorBytes")),
    ("storage.expected.modelSha256", expected(baked).get("modelSha256"), expected(candidate).get("modelSha256")),
    ("storage.expected.serialSha256", expected(baked).get("serialSha256"), expected(candidate).get("serialSha256")),
    ("cpuVendor", baked.get("cpuVendor"), candidate.get("cpuVendor")),
]

mismatches = [(name, baked_value, candidate_value) for name, baked_value, candidate_value in checks if baked_value != candidate_value]
if mismatches:
    for name, baked_value, candidate_value in mismatches:
        print(
            f"verify_host_match: {host}: {name} differs: "
            f"baked={baked_value!r} candidate={candidate_value!r}",
            file=sys.stderr,
        )
    sys.exit(1)
print(f"install: host match OK (enrolled record): {host} candidate matches the baked storage/cpu")
PY
  then
    die "the probed hardware does not match the enrolled record for ${host}; refusing to install over it"
  fi
}

# The disk whose live layout holds the held age identity: --disk wins, then the
# freshly probed candidate's storage binding, then the baked record's.
rescue_disk_by_id() {
  local record id
  for record in "$staging/${host}.json" "$staging/base.json"; do
    [[ -f "$record" ]] || continue
    id=$(python3 -c 'import json, sys
storage = json.load(open(sys.argv[1])).get("storage") or {}
print(storage.get("diskById") or "")' "$record" 2>/dev/null) || id=""
    if [[ -n "$id" ]]; then
      printf '%s\n' "$id"
      return 0
    fi
  done
  return 1
}

# Unmount the rescue mountpoint if it is mounted, then remove its directory.
# A failure to unmount is fatal so nothing proceeds to the wipe with a live
# scratch mount.
_rescue_umount() {
  [[ -n "${RESCUE_MNT:-}" ]] || return 0
  if mountpoint -q -- "$RESCUE_MNT" 2>/dev/null; then
    if ! timeout 30 umount -- "$RESCUE_MNT" 2>/dev/null; then
      timeout 30 umount -l -- "$RESCUE_MNT" 2>/dev/null \
        || die "--rescue-identity: could not unmount ${RESCUE_MNT}; refusing to continue"
    fi
  fi
  rmdir -- "$RESCUE_MNT" 2>/dev/null || true
  RESCUE_MNT=""
}

_rescue_cleanup() {
  _rescue_umount
  _staging_cleanup
}

# --rescue-identity: read the held age identity off the live layout on the disk
# being replaced. The mount is read-only with nologreplay, so it cannot mutate
# the old system; the fallback mounts the top-level subvolume and looks for
# @home by hand. Dies when the flag is set and the identity is missing - the
# caller asked for it, so a silent miss would let the wipe destroy the only copy.
rescue_age_identity() {
  local stage="$1"
  require_live_root

  local disk_id="${disk:-}"
  if [[ -z "$disk_id" ]]; then
    disk_id=$(rescue_disk_by_id) \
      || die "--rescue-identity: cannot determine the target disk; pass --disk <by-id basename>"
  fi
  local part="/dev/disk/by-id/${disk_id}-part2"
  [[ -e "$part" ]] || die "--rescue-identity: ${part} does not exist; cannot read the live identity"

  RESCUE_MNT=$(mktemp -d -- "${TMPDIR:-/tmp}/nixos-rescue.XXXXXXXX") \
    || die "--rescue-identity: cannot create a mountpoint"
  trap '_rescue_cleanup' EXIT

  if ! timeout 30 mount -o ro,nologreplay,subvol=/@home -- "$part" "$RESCUE_MNT" 2>/dev/null; then
    timeout 30 mount -o ro,nologreplay,subvolid=5 -- "$part" "$RESCUE_MNT" \
      || { _rescue_umount; die "--rescue-identity: cannot mount ${part} read-only"; }
  fi

  local key="" candidate
  for candidate in \
    "$RESCUE_MNT/${install_user}/.config/sops/age/keys.txt" \
    "$RESCUE_MNT/@home/${install_user}/.config/sops/age/keys.txt" \
    "$RESCUE_MNT/home/${install_user}/.config/sops/age/keys.txt"; do
    if [[ -f "$candidate" ]]; then
      key="$candidate"
      break
    fi
  done
  if [[ -z "$key" ]]; then
    _rescue_umount
    die "--rescue-identity: no age identity at ${install_user}/.config/sops/age/keys.txt on ${part}; refusing to wipe without the held identity"
  fi

  local rc=0
  staging_identity "$stage" "$install_user" "$install_uid" "$install_gid" "$key" || rc=$?
  _rescue_umount
  (( rc == 0 )) || die "--rescue-identity: could not stage the rescued identity from ${part}"
  printf 'install: rescued the age identity from %s (read-only)\n' "$part"
  return 0
}

# The artifacts persist in the installed system whether or not the host key
# was folded, so an unfolded key is a warning, not a stop. --save stays
# available as an optional escape hatch that keeps an extra copy on disk.
announce_unfolded_key() {
  printf 'install: warning: the host key was not folded into the sops store; the enrollment artifacts are staged into the installed system, and --save DIR still keeps an extra copy on persistent storage\n' >&2
}

install_phase() {
  printf 'install: installing %s on this machine; --yes was given and the install erases the enrolled disk\n' "$host"
  local -a transport=()
  if [[ -n "${stage:-}" ]]; then
    transport+=(--extra-files "$stage")
  fi
  if [[ -n "${install_user:-}" ]]; then
    # staging_identity reports the same ownership pair, so the stage always
    # forwards it and the user-owned .config subtree stays user-owned.
    transport+=(--chown "home/${install_user}/.config" "${install_uid}:${install_gid}")
  fi
  "$workdir/bin/host-install.sh" \
    --host "$host" \
    --target-host "$target_host" \
    --install-only \
    --yes \
    --skip-verify \
    "${transport[@]}"
}

require_live_root() {
  [[ "$allow_mounted_root" == true ]] && return 0
  local fstype
  fstype=$(awk '$2 == "/" { print $3; exit }' /proc/mounts)
  case "$fstype" in
    tmpfs|ramfs|overlay|squashfs) return 0 ;;
  esac
  die "/ is a '$fstype' filesystem; the install erases the enrolled disk and must run from a live environment (e.g. the flake ISO) so the running root is not destroyed underneath it. Use --allow-mounted-root only when the target disk is not the running root."
}

if [[ "$install_only" == true ]]; then
  [[ -f "$workdir/config/hosts/intake/${host}.json" ]] \
    || die "--install-only needs an enrolled work tree (${workdir}/config/hosts/intake/${host}.json is missing)"
  [[ "$assume_yes" == true ]] || die "the install stage requires --yes"
  require_live_root
  install_phase
  exit 0
fi

prepare_worktree
enroll
verify_host_match
save_artifacts
fold_host_key
save_artifacts

if [[ "$want_save" == true && -z "$save_dir" ]]; then
  announce_unfolded_key
fi

if [[ "$assume_yes" != true ]]; then
  printf 'install: enrollment checkpoint complete in %s; re-run with --yes to install (the enrolled disk is erased)\n' "$workdir"
  exit 0
fi

resolve_identity
[[ -n "$install_user" ]] || die "cannot resolve the enrolled user identity for ${host}; refusing to stage the password"
stage_install_payload

setup_self_ssh
require_live_root
install_phase
