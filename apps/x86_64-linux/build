#!/usr/bin/env bash
set -euo pipefail

host=""
build_args=()

while (( $# > 0 )); do
  case "$1" in
    --host=*)
      host=${1#*=}
      shift
      ;;
    --host)
      if (( $# < 2 )); then
        echo 'build: --host requires a value' >&2
        exit 2
      fi
      host=$2
      shift 2
      ;;
    --help|-h)
      cat <<'EOF'
Usage: build [--host HOST] [--] [nix build arguments...]

Builds the selected NixOS toplevel without switching, changing boot entries,
or deleting generations. Defaults to the current hostname, the same default as
build-switch.
EOF
      exit 0
      ;;
    --)
      shift
      build_args+=("$@")
      break
      ;;
    *)
      build_args+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$host" ]]; then
  host="$(hostname -s)"
fi

# Prefer the caller's checkout when the command is run from a flake root.
# Otherwise fall back to the store copy that contains this script.
flake_root="$PWD"
if [[ ! -f "$flake_root/flake.nix" ]]; then
  flake_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
fi

if git -C "$flake_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  flake_ref="git+file://${flake_root}"
else
  flake_ref="path:${flake_root}"
fi

exec nix build "${flake_ref}#nixosConfigurations.${host}.config.system.build.toplevel" \
  "${build_args[@]}"
