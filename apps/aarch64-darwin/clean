#!/usr/bin/env bash
set -euo pipefail

green='\033[1;32m'
yellow='\033[1;33m'
reset='\033[0m'

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  printf '%s\n' 'Usage: clean' '' 'Deletes system generations older than seven days.'
  exit 0
fi

# sudo resets PATH to its own secure path, so resolve the collector before
# escalating instead of relying on the command being found by sudo.
nix_gc="$(command -v nix-collect-garbage || true)"
if [[ -z $nix_gc ]]; then
  printf '%s\n' 'clean: nix-collect-garbage is not on PATH' >&2
  exit 1
fi

printf '%b\n' "${yellow}Cleaning up old system generations...${reset}"
sudo "$nix_gc" --delete-older-than 7d
printf '%b\n' "${green}Cleanup complete.${reset}"
