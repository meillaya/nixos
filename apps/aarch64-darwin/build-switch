#!/bin/sh -e

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Prefer the caller's checkout when the command is run from a flake root.
# Otherwise fall back to the store copy that contains this script.
flake_root="$PWD"
if [ ! -f "$flake_root/flake.nix" ]; then
  flake_root="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)"
fi

# A git flake sees tracked files only, so ignored secrets cannot enter the
# world-readable Nix store.
if git -C "$flake_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  flake_ref="git+file://${flake_root}"
else
  flake_ref="path:${flake_root}"
fi

# The darwin output is keyed by host name, never by system (see
# modules/aspects/inventory.nix); read the host from the flake so a rename cannot
# leave this script switching a non-existent attribute.
HOST="$(nix --extra-experimental-features 'nix-command flakes' eval --raw --no-warn-dirty \
  "${flake_ref}#darwinConfigurations" --apply 'x: builtins.head (builtins.attrNames x)')"

export NIXPKGS_ALLOW_UNFREE=1

echo "${YELLOW}Starting build...${NC}"
nix --extra-experimental-features 'nix-command flakes' build \
  "${flake_ref}#darwinConfigurations.${HOST}.system"

echo "${YELLOW}Switching to new generation...${NC}"
# See https://github.com/nix-darwin/nix-darwin/issues/1457 on why we need sudo
sudo ./result/sw/bin/darwin-rebuild switch --flake "${flake_ref}#${HOST}" "$@"

echo "${YELLOW}Cleaning up...${NC}"
rm -f ./result

echo "${GREEN}Switch to new generation complete!${NC}"
